# MunnaVPS configuration
# Copy to .env with `make setup` (recommended: it generates a strong password).

# --- Access -----------------------------------------------------------------
# Public site address used by Caddy.
#   ":80"                 -> plain HTTP on port 80 (LAN / VPN / IP only)
#   "desktop.example.com" -> automatic HTTPS via Let's Encrypt (ports 80+443
#                            must be reachable and DNS must point at the host)
#   "localhost"           -> HTTPS with Caddy's internal CA
SITE_ADDRESS=:80

# Host ports mapped to Caddy inside the container.
HTTP_PORT=80
HTTPS_PORT=443

# --- Desktop user -----------------------------------------------------------
DESKTOP_USER=munna

# UID/GID used inside the container. Match your host user on Linux so files in
# ./data are readable without root.
PUID=1000
PGID=1000

# KasmVNC login password for DESKTOP_USER. Minimum 6 characters.
# `make setup` replaces this placeholder automatically.
VNC_PASSWORD=change-me-before-starting

# --- Desktop session --------------------------------------------------------
TZ=UTC
VNC_RESOLUTION=1920x1080
VNC_DEPTH=24

# --- Resource limits (default profile: 4 GB / 4 vCPU) ----------------------
DESKTOP_MEM_LIMIT=4g
DESKTOP_CPUS=4.0
DESKTOP_SHM_SIZE=2gb

# --- Storage ----------------------------------------------------------------
# Desktop home lives at ${DATA_DIR}/desktop, Caddy state at ${DATA_DIR}/caddy.
DATA_DIR=./data

# --- Image / upstream -------------------------------------------------------
# Ubuntu tag to build from. "latest" is intentional: KasmVNC publishes a
# matching package for the current Ubuntu release.
UBUNTU_TAG=latest

# KasmVNC release: "latest" or an explicit version like "1.5.2".
KASMVNC_VERSION=latest

# Escape hatch: a direct .deb URL. Leave empty to resolve automatically.
# KASMVNC_ASSET_URL=

# Local image tag suffix.
IMAGE_TAG=latest

# Caddy upstream target. Override with `make up-tigervnc` to use the
# TigerVNC + noVNC fallback (desktop:6080).
DESKTOP_UPSTREAM=desktop:6901
